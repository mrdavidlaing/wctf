// Place your key bindings in this file to override the defaults
[
    // Run python file in terminal (non-test files)
    {
        "key": "ctrl+space r",
        "command": "python.execInTerminal",
        "when": "editorLangId == python && resourceFilename !~ /test_.*\\.py$/ && resourceFilename !~ /.*_test\\.py$/"
    },
    // Smart run: runs test at cursor if in test file
    {
        "key": "ctrl+space r",
        "command": "testing.runAtCursor",
        "when": "editorLangId == python && (resourceFilename =~ /test_.*\\.py$/ || resourceFilename =~ /.*_test\\.py$/)"
    },
    // Debug python file (non-test files)
    {
        "key": "ctrl+space shift+r",
        "command": "workbench.action.debug.start",
        "when": "editorLangId == python && resourceFilename !~ /test_.*\\.py$/ && resourceFilename !~ /.*_test\\.py$/"
    },
    // Smart debug: debug test at cursor if in test file
    {
        "key": "ctrl+space shift+r",
        "command": "testing.debugAtCursor",
        "when": "editorLangId == python && (resourceFilename =~ /test_.*\\.py$/ || resourceFilename =~ /.*_test\\.py$/)"
    },
    // Run all tests in workspace
    {
        "key": "ctrl+space a",
        "command": "testing.runAll"
    },
    // Toggle breakpoint
    {
        "key": "ctrl+space b",
        "command": "editor.debug.action.toggleBreakpoint"
    },
    // Stop debugging
    {
        "key": "ctrl+space s",
        "command": "workbench.action.debug.stop"
    },
    // Step Over
    {
        "key": "ctrl+space l",
        "command": "workbench.action.debug.stepOver"
    },
    // Step Into
    {
        "key": "ctrl+space j",
        "command": "workbench.action.debug.stepInto"
    },
    // Step Out
    {
        "key": "ctrl+space k",
        "command": "workbench.action.debug.stepOut"
    },
    // Continue
    {
        "key": "ctrl+space c",
        "command": "workbench.action.debug.continue"
    },
    // Fix and format document (runs Ruff auto-fix then formats)
    {
        "key": "ctrl+space f",
        "command": "runCommands",
        "args": {
            "commands": [
                "ruff.executeAutofix",
                "editor.action.formatDocument"
            ]
        },
        "when": "editorTextFocus && !editorHasSelection && editorLangId == python"
    },
    // Format selection
    {
        "key": "ctrl+space f",
        "command": "editor.action.formatSelection",
        "when": "editorTextFocus && editorHasSelection"
    },
    // Toggle line comment
    {
        "key": "ctrl+space /",
        "command": "editor.action.commentLine",
        "when": "editorTextFocus"
    }
]
